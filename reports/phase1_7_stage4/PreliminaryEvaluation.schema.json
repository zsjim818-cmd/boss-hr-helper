{
  "$defs": {
    "GroupCheck": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "operator": {
          "enum": [
            "ALL",
            "ANY"
          ],
          "title": "Operator",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "members": {
          "items": {
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "operator",
        "status",
        "members",
        "reason"
      ],
      "title": "GroupCheck",
      "type": "object"
    },
    "GroupSelection": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "operator": {
          "enum": [
            "ALL",
            "ANY"
          ],
          "title": "Operator",
          "type": "string"
        },
        "dimension_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension Id"
        },
        "selected_members": {
          "items": {
            "type": "string"
          },
          "title": "Selected Members",
          "type": "array"
        },
        "member_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Member Scores",
          "type": "object"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "operator",
        "selected_members",
        "member_scores",
        "reason"
      ],
      "title": "GroupSelection",
      "type": "object"
    },
    "PolicyThresholds": {
      "additionalProperties": false,
      "properties": {
        "coarse_pass": {
          "maximum": 100,
          "minimum": 0,
          "title": "Coarse Pass",
          "type": "number"
        },
        "deep_review": {
          "maximum": 100,
          "minimum": 0,
          "title": "Deep Review",
          "type": "number"
        },
        "deep_recommend": {
          "maximum": 100,
          "minimum": 0,
          "title": "Deep Recommend",
          "type": "number"
        }
      },
      "required": [
        "coarse_pass",
        "deep_review",
        "deep_recommend"
      ],
      "title": "PolicyThresholds",
      "type": "object"
    },
    "PreliminaryDimensionScore": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "title": "Dimension Id",
          "type": "string"
        },
        "dimension_label": {
          "title": "Dimension Label",
          "type": "string"
        },
        "dimension_weight": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Dimension Weight",
          "type": "number"
        },
        "raw_score": {
          "minimum": 0,
          "title": "Raw Score",
          "type": "number"
        },
        "normalized_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Normalized Score",
          "type": "number"
        },
        "matched_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Matched Requirements",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PrescreenEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "keyword_budget": {
          "default": 0.0,
          "minimum": 0,
          "title": "Keyword Budget",
          "type": "number"
        },
        "matched_budget": {
          "default": 0.0,
          "minimum": 0,
          "title": "Matched Budget",
          "type": "number"
        },
        "evidence_quality": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Quality",
          "type": "number"
        }
      },
      "required": [
        "dimension_id",
        "dimension_label",
        "dimension_weight",
        "raw_score",
        "normalized_score"
      ],
      "title": "PreliminaryDimensionScore",
      "type": "object"
    },
    "PrescreenEvidence": {
      "additionalProperties": false,
      "properties": {
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "source_kind": {
          "title": "Source Kind",
          "type": "string"
        },
        "context": {
          "enum": [
            "FACT",
            "PRACTICE",
            "ASSERTED",
            "LEARNING",
            "NEGATED",
            "NO_PRACTICE",
            "MENTION",
            "AMBIGUOUS"
          ],
          "title": "Context",
          "type": "string"
        },
        "canonical": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical"
        },
        "matched_variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Variant"
        },
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "dimension_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dimension Ids",
          "type": "array"
        },
        "source_weight": {
          "default": 0.0,
          "minimum": 0,
          "title": "Source Weight",
          "type": "number"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "source_path",
        "quote",
        "start",
        "end",
        "source_kind",
        "context"
      ],
      "title": "PrescreenEvidence",
      "type": "object"
    },
    "RequirementCheck": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "filter_ids": {
          "items": {
            "type": "string"
          },
          "title": "Filter Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PrescreenEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "hard_eligible": {
          "default": true,
          "title": "Hard Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "requirement_id",
        "status",
        "reason"
      ],
      "title": "RequirementCheck",
      "type": "object"
    },
    "Tier0Result": {
      "additionalProperties": false,
      "properties": {
        "hard_filter_status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ],
          "title": "Hard Filter Status",
          "type": "string"
        },
        "matched_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Matched Requirements",
          "type": "array"
        },
        "failed_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Failed Requirements",
          "type": "array"
        },
        "unknown_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Requirements",
          "type": "array"
        },
        "atomic_results": {
          "items": {
            "$ref": "#/$defs/RequirementCheck"
          },
          "title": "Atomic Results",
          "type": "array"
        },
        "group_results": {
          "items": {
            "$ref": "#/$defs/GroupCheck"
          },
          "title": "Group Results",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PrescreenEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "review_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "skipped_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Skipped Requirements",
          "type": "array"
        }
      },
      "required": [
        "hard_filter_status"
      ],
      "title": "Tier0Result",
      "type": "object"
    },
    "Tier1Result": {
      "additionalProperties": false,
      "properties": {
        "preliminary_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Preliminary Score",
          "type": "number"
        },
        "dimension_scores": {
          "items": {
            "$ref": "#/$defs/PreliminaryDimensionScore"
          },
          "title": "Dimension Scores",
          "type": "array"
        },
        "matched_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Matched Requirements",
          "type": "array"
        },
        "unknown_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Requirements",
          "type": "array"
        },
        "keyword_evidence": {
          "items": {
            "$ref": "#/$defs/PrescreenEvidence"
          },
          "title": "Keyword Evidence",
          "type": "array"
        },
        "review_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "group_selections": {
          "items": {
            "$ref": "#/$defs/GroupSelection"
          },
          "title": "Group Selections",
          "type": "array"
        },
        "canonical_count": {
          "default": 0,
          "minimum": 0,
          "title": "Canonical Count",
          "type": "integer"
        },
        "matched_canonical_count": {
          "default": 0,
          "minimum": 0,
          "title": "Matched Canonical Count",
          "type": "integer"
        }
      },
      "required": [
        "preliminary_score",
        "dimension_scores"
      ],
      "title": "Tier1Result",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "org_id": {
      "title": "Org Id",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "job_candidate_id": {
      "title": "Job Candidate Id",
      "type": "string"
    },
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "exclusiveMinimum": 0,
      "title": "Policy Version",
      "type": "integer"
    },
    "policy_hash": {
      "title": "Policy Hash",
      "type": "string"
    },
    "resume_id": {
      "title": "Resume Id",
      "type": "string"
    },
    "resume_content_hash": {
      "title": "Resume Content Hash",
      "type": "string"
    },
    "input_kind": {
      "enum": [
        "SEALED",
        "PARTIAL_PREVIEW"
      ],
      "title": "Input Kind",
      "type": "string"
    },
    "data_completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "COLLECTION_FAILED"
      ],
      "title": "Data Completeness",
      "type": "string"
    },
    "input_has_issues": {
      "default": false,
      "title": "Input Has Issues",
      "type": "boolean"
    },
    "score_kind": {
      "const": "POLICY_TIER1_PRELIMINARY",
      "default": "POLICY_TIER1_PRELIMINARY",
      "title": "Score Kind",
      "type": "string"
    },
    "assessment_scope": {
      "const": "TIER0_TIER1_ONLY",
      "default": "TIER0_TIER1_ONLY",
      "title": "Assessment Scope",
      "type": "string"
    },
    "interpreter_version": {
      "title": "Interpreter Version",
      "type": "string"
    },
    "execution_profile_version": {
      "title": "Execution Profile Version",
      "type": "string"
    },
    "execution_profile_hash": {
      "title": "Execution Profile Hash",
      "type": "string"
    },
    "hard_filter_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "Hard Filter Status",
      "type": "string"
    },
    "preliminary_score": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preliminary Score"
    },
    "dimension_scores": {
      "items": {
        "$ref": "#/$defs/PreliminaryDimensionScore"
      },
      "title": "Dimension Scores",
      "type": "array"
    },
    "matched_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Matched Requirements",
      "type": "array"
    },
    "failed_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Failed Requirements",
      "type": "array"
    },
    "unknown_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Unknown Requirements",
      "type": "array"
    },
    "keyword_evidence": {
      "items": {
        "$ref": "#/$defs/PrescreenEvidence"
      },
      "title": "Keyword Evidence",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/PrescreenEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "review_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Review Reasons",
      "type": "array"
    },
    "scoring_status": {
      "enum": [
        "SCORING_FAILED",
        "HARD_FILTERED",
        "DATA_INCOMPLETE",
        "HARD_UNKNOWN",
        "BELOW_COARSE",
        "READY_FOR_DEEP"
      ],
      "title": "Scoring Status",
      "type": "string"
    },
    "thresholds": {
      "$ref": "#/$defs/PolicyThresholds"
    },
    "coarse_passed": {
      "default": false,
      "title": "Coarse Passed",
      "type": "boolean"
    },
    "deep_thresholds_applied": {
      "const": false,
      "default": false,
      "title": "Deep Thresholds Applied",
      "type": "boolean"
    },
    "deep_score": {
      "default": null,
      "title": "Deep Score",
      "type": "null"
    },
    "tier0": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tier0Result"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tier1": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tier1Result"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    }
  },
  "required": [
    "org_id",
    "candidate_id",
    "job_id",
    "job_candidate_id",
    "policy_id",
    "policy_version",
    "policy_hash",
    "resume_id",
    "resume_content_hash",
    "input_kind",
    "data_completeness",
    "interpreter_version",
    "execution_profile_version",
    "execution_profile_hash",
    "hard_filter_status",
    "scoring_status",
    "thresholds"
  ],
  "title": "PreliminaryEvaluation",
  "type": "object"
}
