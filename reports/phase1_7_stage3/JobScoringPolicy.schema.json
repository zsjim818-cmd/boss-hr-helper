{
  "$defs": {
    "HardFilter": {
      "additionalProperties": false,
      "properties": {
        "filter_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Filter Id",
          "type": "string"
        },
        "requirement_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "education_level",
            "work_years",
            "expected_salary",
            "city",
            "work_authorization",
            "job_status"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "EQ",
            "NE",
            "GTE",
            "LTE",
            "IN",
            "EXISTS"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Text"
        },
        "value_number": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Number"
        },
        "value_list": {
          "items": {
            "type": "string"
          },
          "title": "Value List",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "year",
                "month",
                "day",
                "hour",
                "level"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "on_unknown": {
          "const": "REVIEW",
          "title": "On Unknown",
          "type": "string"
        }
      },
      "required": [
        "filter_id",
        "requirement_id",
        "field",
        "operator",
        "value_text",
        "value_number",
        "value_list",
        "unit",
        "on_unknown"
      ],
      "title": "HardFilter",
      "type": "object"
    },
    "KeywordGroup": {
      "additionalProperties": false,
