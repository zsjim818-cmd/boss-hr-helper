  "schema_version": "job_scoring_policy_v1",
  "scoring_dimensions": [
    {
      "description": "评估候选人在订单支付等复杂业务场景下的架构设计能力，包括模块化、扩展性及高可用考量。",
      "dimension_id": "dim_service_design",
      "label": "服务设计",
      "requirement_ids": [
        "req_java_dev",
        "req_spring_boot",
        "req_quarkus"
      ],
      "rubric": [
        {
          "description": "仅能编写简单CRUD接口，缺乏对服务边界、依赖管理及异常处理的系统性思考，无法应对复杂业务变更。",
          "max_score": 40,
          "min_score": 0
        },
        {
          "description": "能够独立设计单体应用内的模块划分，熟悉Spring Boot/Quarkus常用组件，具备基本的接口版本管理和日志规范意识。",
          "max_score": 70,
          "min_score": 41
        },
        {
          "description": "主导过微服务拆分或核心链路重构，深入理解CAP理论在支付场景的应用，能通过架构调整显著提升系统吞吐量与稳定性。",
          "max_score": 100,
          "min_score": 71
        }
      ],
      "weight": 0.3
    },
    {
      "description": "考察候选人对关系型数据库事务隔离级别、并发冲突及数据一致性保障机制的理解与实践深度。",
      "dimension_id": "dim_data_correctness",
      "label": "数据正确性",
      "requirement_ids": [
        "req_sql_txn"
      ],
      "rubric": [
        {
          "description": "仅掌握基础SQL增删改查，不理解事务回滚机制，面对并发更新时容易引发脏读或丢失更新，缺乏数据校验手段。",
          "max_score": 40,
          "min_score": 0
        },
        {
          "description": "熟练运用乐观锁或悲观锁处理常见并发场景，能根据业务需求选择合适的事务隔离级别，并建立基本的数据对账机制。",
          "max_score": 70,
          "min_score": 41
        },
        {
          "description": "精通分布式事务解决方案（如TCC/Saga），能设计幂等性接口防止重复扣款，并通过全链路数据审计确保资金绝对安全。",
          "max_score": 100,
          "min_score": 71
        }
      ],
      "weight": 0.3
    },
    {
      "description": "评估候选人定位线上性能瓶颈、内存泄漏及网络抖动等复杂问题的方法论与实战经验。",
      "dimension_id": "dim_troubleshooting",
      "label": "故障排查",
      "requirement_ids": [
        "req_java_dev"
      ],
      "rubric": [
        {
          "description": "依赖重启服务解决偶发错误，缺乏查看堆栈日志和分析线程转储的能力，无法区分应用层与基础设施层的故障根源。",
          "max_score": 40,
          "min_score": 0
        },
        {
          "description": "能熟练使用Arthas/JStack等工具分析CPU飙高或Full GC原因，通过日志关联分析快速锁定慢SQL或第三方接口超时问题。",
          "max_score": 70,
          "min_score": 41
        },
        {
          "description": "具备构建可观测性体系的经验，能通过链路追踪精准定位跨服务调用中的性能损耗点，并制定预防性的熔断降级策略。",
          "max_score": 100,
          "min_score": 71
        }
      ],
      "weight": 0.2
    },
    {
      "description": "衡量候选人构建自动化测试体系、提升代码覆盖率及保障交付质量的工程化水平。",
      "dimension_id": "dim_test_quality",
      "label": "测试质量",
      "requirement_ids": [
        "req_auto_test"
      ],
      "rubric": [
        {
          "description": "主要依赖手工测试，自动化测试覆盖率极低，测试用例缺乏边界条件覆盖，导致回归测试成本高且易漏测。",
          "max_score": 40,
          "min_score": 0
        },
        {
          "description": "建立了核心的接口自动化测试流水线，关键路径单元测试覆盖率达标，能利用Mock技术隔离外部依赖进行高效验证。",
          "max_score": 70,
          "min_score": 41
        },
        {
          "description": "推行契约测试与混沌工程实践，自动化测试成为CI/CD的强制门禁，显著降低了生产环境缺陷逃逸率并提升了发布信心。",
          "max_score": 100,
          "min_score": 71
        }
      ],
      "weight": 0.15
    },
    {
      "description": "评估候选人与产品、运营等非技术角色协作，准确理解业务意图并转化为技术方案的能力。",
      "dimension_id": "dim_communication",
      "label": "业务沟通",
      "requirement_ids": [
        "req_java_dev"
      ],
      "rubric": [
        {
          "description": "被动接收需求，难以发现业务逻辑漏洞，沟通中常出现技术术语壁垒，导致需求理解偏差或返工。",
          "max_score": 40,
          "min_score": 0
        },
        {
          "description": "能主动澄清模糊需求，用通俗语言解释技术限制与权衡，协助产品经理优化不合理流程，确保交付符合业务预期。",
          "max_score": 70,
          "min_score": 41
        },
        {
          "description": "具备业务洞察力，能从技术视角提出产品改进建议，有效管理多方利益相关者预期，推动跨部门协作达成共同目标。",
          "max_score": 100,
          "min_score": 71
        }
      ],
      "weight": 0.05
    }
  ],
