  "schema_version": "job_scoring_policy_v1",
  "scoring_dimensions": [
    {
      "description": "评估候选人是否具备从需求到可维护、可测试程序的完整交付能力，重点考察项目完整性与代码质量意识。",
      "dimension_id": "dim_delivery",
      "label": "应用交付",
      "requirement_ids": [
        "req_py_01",
        "req_route_a_llm",
        "req_route_a_rag",
        "req_route_b_web"
      ],
      "rubric": [
        {
          "description": "仅有技术名词堆砌，无具体项目描述，或项目仅为教程复现且未做修改，无法证明独立交付能力。",
          "max_score": 24,
          "min_score": 0
        },
        {
          "description": "有简单脚本或小模块开发经验，能说明基本逻辑，但缺乏对整体架构、依赖管理或版本控制的考量，交付物需大量人工干预才能运行。",
          "max_score": 49,
          "min_score": 25
        },
        {
          "description": "独立完成过中等复杂度的AI应用或自动化流程，代码结构清晰，包含基本的单元测试或类型提示，能解释设计决策，交付物可直接用于内部小规模场景。",
          "max_score": 74,
          "min_score": 50
        },
        {
          "description": "主导过生产级或高复杂度项目，具备模块化设计、CI/CD集成意识，代码可维护性强，有明确的验收标准和文档，能应对边界情况并保证长期稳定运行。",
          "max_score": 100,
          "min_score": 75
        }
      ],
      "weight": 0.5
    },
    {
      "description": "评估候选人在异常处理、接口测试及故障恢复方面的工程实践，确保程序在真实环境中的鲁棒性。",
      "dimension_id": "dim_reliability",
      "label": "程序可靠性",
      "requirement_ids": [
        "req_exc_01",
        "req_api_test_01",
        "req_route_b_retry"
      ],
      "rubric": [
        {
          "description": "未提及异常处理或测试，认为'代码没报错就是好的'，缺乏对运行时错误的预判和处理机制。",
          "max_score": 24,
          "min_score": 0
        },
        {
          "description": "知道try-except的基本用法，能进行简单的打印调试，但缺乏系统性的日志记录、错误分类或自动化测试覆盖，故障排查依赖手动复现。",
          "max_score": 49,
          "min_score": 25
        },
        {
          "description": "能规范地编写异常处理逻辑，区分可恢复与不可恢复错误，使用logging模块记录关键信息，并对核心接口编写了基础的单元或集成测试用例。",
          "max_score": 74,
          "min_score": 50
        },
        {
          "description": "具备完善的容错设计，包括指数退避重试、熔断机制、死信队列处理等，测试覆盖率高且包含混沌工程或压力测试思维，能主动监控并告警潜在风险。",
          "max_score": 100,
          "min_score": 75
        }
      ],
      "weight": 0.25
    },
    {
      "description": "评估候选人利用AI或自动化技术优化业务流程、提升工作效率的实际效果与方法论。",
      "dimension_id": "dim_efficiency",
      "label": "流程提效",
      "requirement_ids": [
        "req_route_a_rag",
        "req_route_b_web",
        "req_n8n_01"
      ],
      "rubric": [
        {
          "description": "不了解自动化带来的业务价值，仅关注技术实现本身，无法说明其工作如何影响业务指标或人力成本。",
          "max_score": 24,
          "min_score": 0
        },
        {
          "description": "能识别简单的重复性任务并进行自动化，但缺乏对流程瓶颈的分析，提效幅度有限，且未考虑自动化引入的新维护成本。",
          "max_score": 49,
          "min_score": 25
        },
        {
          "description": "能通过RAG或Web自动化显著减少人工操作步骤，有量化的效率提升数据（如时间缩短50%），并能平衡自动化覆盖率与维护复杂度。",
          "max_score": 74,
          "min_score": 50
        },
        {
          "description": "具备端到端的流程再造能力，不仅自动化执行环节，还优化了数据流转与决策逻辑，带来显著的业务ROI，并能推广最佳实践给团队。",
          "max_score": 100,
          "min_score": 75
        }
      ],
      "weight": 0.15
    },
    {
      "description": "评估候选人将模糊业务需求转化为明确技术规格的能力，以及沟通协作中的准确性。",
      "dimension_id": "dim_understanding",
      "label": "需求理解",
      "requirement_ids": [
        "req_py_01",
        "req_route_a_llm",
        "req_route_b_web"
      ],
      "rubric": [
        {
          "description": "被动接受指令，无法澄清需求歧义，导致交付物与预期偏差大，缺乏主动确认边界的习惯。",
          "max_score": 24,
          "min_score": 0
        },
        {
          "description": "能理解基本需求，但在面对复杂或非结构化需求时，难以拆解为技术子任务，偶尔需要多次返工以对齐目标。",
          "max_score": 49,
          "min_score": 25
        },
        {
          "description": "能主动提问以澄清需求细节，准确界定输入输出与约束条件，能将业务语言转化为清晰的技术方案，返工率低。",
          "max_score": 74,
          "min_score": 50
        },
        {
          "description": "具备产品思维，能从用户视角审视需求合理性，提出优化建议，并在技术方案中体现对业务目标的深刻理解，沟通高效且精准。",
          "max_score": 100,
          "min_score": 75
        }
      ],
      "weight": 0.1
    }
  ],
